# Text is LF in the repository and LF in every checkout, Windows included.
# content/stamp.py versions each stylesheet and script URL by an MD5 of the
# file's bytes, and CI computes it on LF files; a CRLF checkout gave every
# file a different hash locally, so a branch switch restamped all 75 pages.
# Explicit here so the repo does not depend on anyone's core.autocrlf setting.
* text=auto eol=lf

*.html  text
*.css   text
*.js    text
*.json  text
*.py    text
*.md    text
*.txt   text
*.xml   text

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.docx binary

# Vendored libraries are byte-exact third-party artefacts. Their SHA-256 is
# recorded in site/assets/js/vendor/README.md, and `*.js text` above would
# rewrite them to CRLF on a Windows checkout, quietly invalidating it.
site/assets/js/vendor/*.js -text
