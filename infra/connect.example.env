# Connection settings for one environment, kept on YOUR computer only.
#
#   cp infra/connect.example.env infra/connect.production.env   (and .staging.env)
#
# Fill it in while you follow docs/production-runbook.md, "Connecting
# Supabase and Resend". Git ignores infra/connect.*.env, so it is never
# committed. infra/scripts/push-settings.sh turns it into the server's
# app.env, migrate.env and /etc/msmtprc, with the right owners and modes.
#
# One value per line, no quotes, no comments after a value.

# --- Where ------------------------------------------------------------------
# production | staging
DEPLOY_ENV=production
# https://dr-rayhab.com, or https://staging.dr-rayhab.com
PUBLIC_ORIGIN=https://dr-rayhab.com

# --- Supabase (Project Settings > API, and the Connect button) --------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The anon (or publishable) key. Public by design; used only by the server.
SUPABASE_ANON_KEY=
# Connect > Session pooler URL, user changed to rayhab_app.<project-ref>,
# with the password you gave rayhab_app in setup.sql.
DATABASE_URL=
# The same session pooler URL with the postgres user and the database password.
DATABASE_MIGRATE_URL=

# --- Resend (API Keys; the domain must be verified) --------------------------
# A key with Sending access only. It becomes the SMTP password in /etc/msmtprc.
RESEND_API_KEY=
# An address on the verified domain.
EMAIL_FROM=Rayhab bookings <bookings@dr-rayhab.com>
# Who gets the clinic's notices, comma-separated.
STAFF_EMAILS=

# --- Filled in for you -------------------------------------------------------
# push-settings.sh generates this on the first run and writes it back here,
# so later runs keep it (changing it signs every staff member out).
APP_SECRET=
