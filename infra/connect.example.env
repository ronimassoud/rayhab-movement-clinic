# Connection settings for one environment, kept on YOUR computer only.
#
#   cp infra/connect.example.env infra/connect.production.env   (and .staging.env)
#
# Fill it in while you follow docs/production-runbook.md. Git ignores
# infra/connect.*.env, so it is never committed. From it:
#   node infra/vercel/push-env.mjs <env>   puts the settings into Vercel
#   node api/dev/migrate.mjs <env>         sets up the database
#   node api/dev/check.mjs <env>           checks Supabase and Resend
#   node api/dev/doctor.mjs <env>          checks the whole setup
#
# One value per line, no quotes, no comments after a value.

# --- Where ------------------------------------------------------------------
# production | staging
DEPLOY_ENV=production
# https://dr-rayhab.com, or https://staging.dr-rayhab.com
PUBLIC_ORIGIN=https://dr-rayhab.com

# --- Supabase (Project Settings > API, and the Connect button) --------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The anon (or publishable) key. Public by design; used only by the server.
SUPABASE_ANON_KEY=
# Connect > Session pooler URL, user changed to rayhab_app.<project-ref>,
# with the password you gave rayhab_app in setup.sql. Goes to Vercel.
DATABASE_URL=
# The same session pooler URL with the postgres user and the database
# password. Stays on this computer (migrations); never goes to Vercel.
DATABASE_MIGRATE_URL=

# --- Resend (API Keys; the domain must be verified) --------------------------
# A key with Sending access only. The API sends through Resend's HTTP API.
RESEND_API_KEY=
# An address on the verified domain.
EMAIL_FROM=Rayhab bookings <bookings@dr-rayhab.com>
# Who gets the clinic's notices, comma-separated.
STAFF_EMAILS=

# --- Backups (production) ----------------------------------------------------
# The PUBLIC half of an age key (age1...). Nightly backups (GitHub Actions,
# .github/workflows/backup.yml) are encrypted to it; it goes into the
# BACKUP_RECIPIENT repository secret. Make the key on your own computer:
#   age-keygen -o rayhab-backup-key.txt     (prints "Public key: age1...")
# Keep rayhab-backup-key.txt in your password manager: without it no backup
# can be restored.
BACKUP_RECIPIENT=

# --- Launch phase --------------------------------------------------------------
# Phase 1 (now): cash at the clinic only, and patients are emailed. Phase 2:
# WHISH_DRIVER=whish once the Whish driver exists (sandbox: staging only), and
# PATIENT_CHANNEL=whatsapp once Meta has approved the templates (runbook 6).
WHISH_DRIVER=disabled
PATIENT_CHANNEL=email
# Where patients' replies to the clinic's emails go (the sending address
# only sends). Empty: the API's default, the clinic's current address.
CLINIC_EMAIL=

# --- Filled in for you -------------------------------------------------------
# push-env.mjs generates these on the first run and writes them back here, so
# later runs keep them. Changing APP_SECRET signs every staff member out;
# CRON_SECRET lets Vercel Cron, and only it, run the worker.
APP_SECRET=
CRON_SECRET=
