# /srv/rayhab/<production|staging>/app.env: the PHP API's and the cron worker's
# settings. Owned by deploy, group www-data, mode 640 (Apache passes its path
# to PHP as RAYHAB_ENV_FILE). Never commit a filled-in copy.
# Comments must be on their own lines: Docker reads the rest of a line as
# part of the value. Each value is checked on every request (api/src/Config.php);
# the API answers 503 rather than run with anything missing or unsafe.

# --- Where this runs -------------------------------------------------------
# production | staging
DEPLOY_ENV=production
# staging: https://staging.dr-rayhab.com
PUBLIC_ORIGIN=https://dr-rayhab.com
LOG_LEVEL=info

# 32+ random characters. Generate with:  openssl rand -base64 48
APP_SECRET=

# --- Database (Supabase) ---------------------------------------------------
# The session pooler URL (port 5432), signed in as the rayhab_app role
# (runbook step 5). The schema owner's URL goes in migrate.env, not here.
DATABASE_URL=postgres://rayhab_app.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Staff sign-in (Supabase Auth) -----------------------------------------
AUTH_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Settings > API > anon key (used server-side only)
SUPABASE_ANON_KEY=
SESSION_HOURS=12

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
# off until the sender and templates are approved (runbook step 6).
# cloud | off
WHATSAPP_DRIVER=off
# permanent System User token
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# App settings > Basic > App secret (webhook signatures)
WA_APP_SECRET=
# any random string; the same one goes in Meta's webhook settings
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0
WA_LANG=en

# --- Email (staff alerts) ---------------------------------------------------
# mail = PHP mail() through msmtp; the SMTP account lives in /etc/msmtprc
# (runbook step 6). mail | off
EMAIL_DRIVER=off
# Must be on the domain verified in Resend.
EMAIL_FROM=Rayhab bookings <bookings@dr-rayhab.com>
# comma-separated
STAFF_EMAILS=

# --- Whish -----------------------------------------------------------------
# disabled = cash only. sandbox is for staging only. whish needs the real
# driver written from Whish's merchant documentation (runbook step 7).
WHISH_DRIVER=disabled
WHISH_BASE_URL=
WHISH_MERCHANT_ID=
WHISH_SECRET=

# --- Booking rules ---------------------------------------------------------
# earliest request: tomorrow
LEAD_DAYS=1
HORIZON_DAYS=90
# how long a request (or a proposed new time) holds its time; 72 covers a weekend
HOLD_HOURS=72
# payment link lifetime (and never past the day after the visit)
LINK_TTL_DAYS=14
# "please choose before…" ; 0 for none
PAYMENT_DEADLINE_HOURS=24
POLICY_CASH_TEXT=Pay at reception when you come in.
POLICY_WHISH_TEXT=You pay now through Whish. Your booking is secured once Whish confirms the payment.
CLINIC_NAME=Rayhab Movement Clinic
CLINIC_PHONE=+961 71 383 315
CLINIC_LOCATION=Rayhab Movement Clinic, Beirut

# --- How long personal data is kept (days; 0 keeps it) ---------------------
# Deleted by the worker each hour (api/src/Retention.php). Appointments that
# happened, and payments, are kept: their minimum is for the legal adviser.
# Requests that never became appointments (declined, expired, or cancelled
# before being confirmed or paid), with their messages and patient record:
RETAIN_UNCONFIRMED_DAYS=183
# Website questions, from when they were marked answered (open ones stay):
RETAIN_ANSWERED_QUESTION_DAYS=365
# Message history (recipient, text, delivery status):
RETAIN_MESSAGE_DAYS=90

# ---------------------------------------------------------------------------
# /srv/rayhab/<env>/migrate.env (separate file, mode 600) holds one line:
#   DATABASE_MIGRATE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# It is read only by the one-off migration container during a deploy.
