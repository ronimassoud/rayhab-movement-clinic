{
  "name": "rayhab-server",
  "private": true,
  "type": "module",
  "description": "Booking API and background worker for dr-rayhab.com. See docs/production-runbook.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/dev.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/static": "^10.1.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
